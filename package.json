{
  "name": "web-engiperf",
  "version": "0.0.0",
  "private": true,
  "description": "前端工程化与性能优化实战",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "db:up": "docker compose up -d postgres pgadmin",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "dev:server": "pnpm --filter @web-engiperf/db build && pnpm --filter @web-engiperf/server start:dev",
    "build:server": "pnpm --filter @web-engiperf/db build && pnpm --filter @web-engiperf/server build",
    "seed": "pnpm --filter @web-engiperf/db seed",
    "clean": "pnpm -r exec rimraf dist .next .turbo node_modules"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
