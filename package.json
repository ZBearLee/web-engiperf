{
  "name": "web-engiperf",
  "version": "0.0.0",
  "private": true,
  "description": "前端工程化与性能优化实战",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "db:up": "docker compose up -d postgres pgadmin",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "dev:server": "pnpm --filter @web-engiperf/db build && pnpm --filter @web-engiperf/server start:dev",
    "build:server": "pnpm --filter @web-engiperf/db build && pnpm --filter @web-engiperf/server build",
    "seed": "pnpm --filter @web-engiperf/db seed",
    "clean": "pnpm -r exec rimraf dist .next .turbo node_modules",
    "dev": "concurrently -n web,react,api -c cyan,magenta,green \"pnpm --filter vue-app dev\" \"pnpm --filter react-app dev\" \"pnpm dev:server\"",
    "lint": "pnpm --filter vue-app lint && pnpm --filter @web-engiperf/server lint",
    "lint:check": "pnpm --filter vue-app lint:check && pnpm --filter @web-engiperf/server lint",
    "type-check": "pnpm --filter vue-app type-check",
    "test": "pnpm --filter vue-app test:unit run && pnpm --filter @web-engiperf/server test",
    "test:e2e": "pnpm --filter @web-engiperf/server test:e2e",
    "build": "pnpm --filter @web-engiperf/db build && pnpm --filter @web-engiperf/server build && pnpm --filter vue-app build-only",
    "prepare": "husky",
    "dev:web": "pnpm --filter vue-app dev",
    "dev:react": "pnpm --filter react-app dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "typescript": "^5.6.3"
  }
}
